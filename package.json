{
  "name": "gatsby-starter-aerial",
  "version": "0.0.3",
  "description": "Gatsby.js V5 starter template based on Aerial by HTML5 UP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anubhavsrivastava/gatsby-starter-aerial.git"
  },
  "author": {
    "name": "Anubhav Srivastava",
    "email": "anubhav.srivastava00@gmail.com"
  },
  "dependencies": {
    "gatsby": "5.16.1",
    "gatsby-link": "5.16.0",
    "gatsby-plugin-google-tagmanager": "5.16.0",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-offline": "6.16.0",
    "gatsby-plugin-sass": "6.16.0",
    "gatsby-react-router-scroll": "6.16.0",
    "sass": "^1.83.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "develop": "gatsby develop",
    "build": "npm run clean && gatsby build",
    "deploy": "npm run clean && gatsby build --prefix-paths && gh-pages -d public",
    "serve": "gatsby serve",
    "clean": "rimraf .cache public",
    "format": "prettier --write '**/*.js'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "gh-pages": "^3.2.3",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2"
  },
  "overrides": {
    "gatsby-plugin-sass": {
      "sass-loader": "13.3.3"
    }
  },
  "keywords": [
    "gatsby",
    "gatsby-starter",
    "gatsby-starter-aerial"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anubhavsrivastava/gatsby-starter-aerial/issues"
  },
  "homepage": "https://github.com/anubhavsrivastava/gatsby-starter-aerial#readme"
}
